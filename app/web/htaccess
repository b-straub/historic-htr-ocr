# The headers OCR Lite wants from an Apache 2.4 host (web/dist.py publishes this file as .htaccess beside index.html).
# GitHub Pages ignores it (its own headers apply there); elsewhere it needs AllowOverride FileInfo for the folder.
# Not needed: COOP / COEP (no SharedArrayBuffer, no wasm threads), Range requests (the model comes from Hugging Face).
# HTTPS is the host's job: WebGPU, OPFS and the service worker need a secure context.

# the wasm must be application/wasm (streaming compile); older mime.types lack both
AddType application/wasm .wasm
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # the full CSP is the <meta> in index.html; frame-ancestors only works as a header
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  # always asked again: they name the hashed files of the current build
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # content-hashed (name.<12 hex>.ext): a name never changes its content
  <FilesMatch "\.[0-9a-f]{12}\.(js|css|wasm|png)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/wasm application/manifest+json
</IfModule>
